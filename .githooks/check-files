# check-files — refuses data files and oversized files. Shared by the
# pre-commit hook (staged files) and CI (every tracked file), so a commit made
# with --no-verify, or from a clone without the hook, is still caught on the
# pull request.
#
#   printf '%s\n' file1 file2 | sh .githooks/check-files
#
# Reads repository-relative paths, one per line, from stdin; exits 1 if any is
# refused. Missing paths (deleted files) are skipped.
#
# Data travels as .csv / .txt as often as .sav, so plain-text table formats are
# refused too, unless the file is listed in allowed() below. Adding a file
# there is the deliberate act: only synthetic or public-domain data, generated
# from a fixed seed where possible (see CONTRIBUTING.md, "Test data").

# Files allowed despite their extension. Keep this list short and explain new
# entries in the commit message.
allowed() {
  case "$1" in
    # Synthetic fixtures, each generated by a script next to it
    app/tests/fixtures/import-excel.xlsx | app/tests/fixtures/import-excel-mixed.xlsx) return 0 ;;
    app/tests/py-parity/data.csv) return 0 ;;
    app/tests/spss-parity/data.csv) return 0 ;;
    app/tests/r-validation/fixtures-spss-case-summaries-100.csv) return 0 ;;
    app/tests/r-validation/fixtures-spss-production/gm.csv | app/tests/r-validation/fixtures-spss-production/gm2.csv) return 0 ;;
    # Sample datasets shipped with the app (iris and mtcars are R's own; the
    # other two are synthetic)
    app/resources/sample-data/experiment.csv | app/resources/sample-data/iris.csv) return 0 ;;
    app/resources/sample-data/mtcars.csv | app/resources/sample-data/survey.csv) return 0 ;;
    # Not data
    app/resources/legal/LICENSE.txt) return 0 ;;
    app/resources/r-runtime-win/README.txt | app/resources/r-runtime-mac/README.txt) return 0 ;;
    app/index.html | app/resources/docs/*.html | app/resources/docs/*/*.html) return 0 ;;
  esac
  return 1
}

fail=0
while IFS= read -r f; do
  [ -n "$f" ] || continue
  [ -f "$f" ] || continue

  case "$f" in
    # Statistics-package and binary data formats
    *.sav | *.zsav | *.por | *.sas7bdat | *.xpt | *.dta | *.rds | *.RData | *.parquet | *.sdf | *.spv | *.xlsx | *.xls | *.pdf | \
    *.SAV | *.ZSAV | *.POR | *.SAS7BDAT | *.XPT | *.DTA | *.RDS | *.PARQUET | *.SDF | *.SPV | *.XLSX | *.XLS | *.PDF | \
    *.sqlite | *.db | *.duckdb | *.feather | *.arrow | \
    *.csv | *.tsv | *.tab | *.dat | *.txt | *.CSV | *.TSV | *.TAB | *.DAT | *.TXT | \
    *.htm | *.html | *.HTM | *.HTML)
      if ! allowed "$f"; then
        echo "check-files: data file: $f"
        fail=1
      fi
      ;;
  esac

  size=$(wc -c < "$f" | tr -d ' ')
  if [ "$size" -gt 5242880 ]; then
    echo "check-files: file over 5 MB: $f ($size bytes)"
    fail=1
  fi
done

exit "$fail"
